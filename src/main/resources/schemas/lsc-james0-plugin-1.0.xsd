<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://lsc-project.org/XSD/lsc-james0-plugin-1.0.xsd"
	targetNamespace="http://lsc-project.org/XSD/lsc-james0-plugin-1.0.xsd"
	elementFormDefault="qualified"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	jaxb:version="3.0"
	xmlns:annox="urn:jaxb.jvnet.org:annox"
	xmlns:lsc="http://lsc-project.org/XSD/lsc-core-2.3.xsd"
	jaxb:extensionBindingPrefixes="annox">

	<xsd:import namespace="http://lsc-project.org/XSD/lsc-core-2.3.xsd" schemaLocation="lsc-core-2.3.xsd" />

	<xsd:complexType name="jamesService" abstract="true">
		<xsd:complexContent>
			<xsd:extension base="lsc:serviceType">
				<xsd:sequence>
					<xsd:element name="writableAttributes" type="lsc:valuesType" />
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:element name="jamesAliasService">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="jamesService" />
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="jamesUsersService">
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="jamesService" />
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
